{
  "name": "eslint-plugin-sane",
  "version": "2.2.0",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist --target node && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "eslint": "10.2.0",
    "typescript": "6.0.2"
  },
  "peerDependencies": {
    "typescript": ">=6"
  }
}
